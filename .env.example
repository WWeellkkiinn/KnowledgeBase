# 公网部署环境变量模板。复制为 .env 后填入真实值；.env 不入库。
#
# 生成 token（≥32 字节）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠️ 部署在 ECS Ubuntu + nginx + Docker Compose。nginx 单跳代理到 app，
#    KB_API_TOKEN 等同对外密码，泄露即换。

# ─── 应用核心 ────────────────────────────────────────────────────────
# 用户登录令牌：在 /login 页面输入这个值才能访问
KB_API_TOKEN=REPLACE_ME_USER_TOKEN

# Flask session / Socket.IO 签名密钥；服务器内部用，不暴露给前端
KB_SECRET_KEY=REPLACE_ME_SECRET_KEY

# 公网部署设 1，启用 ProxyFix（信任 nginx 注入的 X-Forwarded-For）。
# nginx → app 是单跳可信代理；app 在容器内绑 0.0.0.0 但只通过 compose 内部网络暴露给 nginx，
# 公网无法直连 app:5000，因此 trust_proxy=1 安全。
KB_TRUST_PROXY=1

# 启动 APScheduler（订阅、日报等后台任务）；serve.py 默认会设 1
KB_ENABLE_SCHEDULER=1

# 单请求体上限（字节）。默认 256KB（收紧 DoS 面）；/papers/upload 不受此约束。
# KB_MAX_CONTENT_LENGTH=262144

# 可选：覆盖默认 CORS（多值用逗号分隔）。同源部署通常无需设置。
# KB_CORS_ORIGINS=http://your-server-ip-or-domain

# ─── 容器内路径 / 网络绑定 ───────────────────────────────────────────
# 容器内 SQLite / papers 路径；compose 把宿主 ./data 整个目录挂到 /app/data
KB_DB_PATH=/app/data/kb.db
PAPERS_DIR=/app/data/papers

# 容器内 Flask 监听地址（compose 内部网络只让 nginx 访问，对外仍然只暴露 80）
KB_BIND_HOST=0.0.0.0

# ─── PDF → MD 云 API（F3）────────────────────────────────────────────
# pdf2md provider：mineru-cloud（默认，需 key）/ local（自托管 MinerU）
KB_PDF2MD_PROVIDER=mineru-cloud
KB_MINERU_API_KEY=REPLACE_ME_MINERU_KEY
# KB_MINERU_API_URL=https://mineru.net
# KB_MINERU_ALLOWED_HOSTS=mineru.net,openxlab.org.cn,aliyuncs.com
# KB_MINERU_POLL_INTERVAL=5
# KB_MINERU_POLL_TIMEOUT=600
# KB_MINERU_ZIP_MAX_BYTES=209715200
# KB_DISABLE_UPLOAD_WORKER=1

# ─── 外部学术 API（原 scripts/config.py 迁出）─────────────────────────
# Unpaywall：免费 OA 探查，只要一个有效邮箱用于 rate-limit 标识
UNPAYWALL_EMAIL=REPLACE_ME_EMAIL

# CORE 全文检索 API
CORE_API_KEY=REPLACE_ME_CORE_KEY

# Semantic Scholar API（多 key 逗号分隔，N 个 key → N req/s）
SS_API_KEY=REPLACE_ME_SS_KEY

# ─── 期刊等级查询（EasyScholar）──────────────────────────────────────
# 登录 https://www.easyscholar.cc/console/user/open 获取（多 key 逗号分隔，N 个 key → N×2 req/s）
EASYSCHOLAR_SECRET_KEY=REPLACE_ME_EASYSCHOLAR_KEY

# ─── 日报邮件（可选）─────────────────────────────────────────────────
# DIGEST_FROM=
# DIGEST_TO=
# DIGEST_AUTH_CODE=

# ─── SaaS rewrite (Django + Postgres + Redis) ────────────────────────
# Django session 签名 / CSRF 密钥；与 KB_SECRET_KEY 解耦，便于独立轮换
DJANGO_SECRET_KEY=REPLACE_ME_DJANGO_SECRET
# 开发置 1（DEBUG 视图+不强制 cookie secure）；生产置 0
DJANGO_DEBUG=0
# 多值用逗号分隔；生产填实际域名
DJANGO_ALLOWED_HOSTS=*

# 同 compose 默认 db 服务；自部署 PG 时改这里
POSTGRES_DB=kb
POSTGRES_USER=kb
POSTGRES_PASSWORD=REPLACE_ME_PG_PASSWORD
# 容器外开发可用 postgres://kb:kb@localhost:5432/kb
DATABASE_URL=postgres://kb:kb@db:5432/kb

# Celery broker / Sesame 后端
REDIS_URL=redis://redis:6379/0

# 魔法链接有效期（秒），默认 900 = 15 分钟
SESAME_MAX_AGE=900

# 邮件后端：开发用 console；生产填 django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
