# 公网部署环境变量模板。复制为 .env 后填入真实值；.env 不入库。
#
# 生成 token（至少 32 字节随机；启动脚本会对 <24 字符的值发警告）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠️ cpolar 是公网 TLS 终止方，可见明文请求体；KB_API_TOKEN 等同对外密码，泄露即换。

# 用户登录令牌：在 /login 页面输入这个值才能访问
KB_API_TOKEN=REPLACE_ME_USER_TOKEN

# Flask session / Socket.IO 签名密钥；服务器内部用，不暴露给前端
KB_SECRET_KEY=REPLACE_ME_SECRET_KEY

# 公网部署设 1，启用 ProxyFix（信任 cpolar 隧道注入的 X-Forwarded-For）。
# ⚠️ 仅当 Flask 绑定 127.0.0.1 + 上游确实是单跳可信代理时才开启。
#    若同时 KB_TRUST_PROXY=1 + 服务绑定 0.0.0.0，任意客户端可伪造 X-Forwarded-For
#    绕过 rate limiter；scripts/serve.py 默认绑 127.0.0.1，请勿改。
KB_TRUST_PROXY=1

# 可选：覆盖默认 CORS（多值用逗号分隔）。公网通常无需设置，因为前端与 API 同源。
# KB_CORS_ORIGINS=https://your-domain.cpolar.cn,https://your-domain.cpolar.top

# 启动 APScheduler（订阅、日报等后台任务）；serve.py 默认会设 1，这里显式也行
KB_ENABLE_SCHEDULER=1

# 单请求体上限（字节）。默认 256KB（收紧 DoS 面）。
# 注意：/papers/upload 端点自身按 50MB 流式校验，**不受**此值约束；
# 仅当其他端点需要更大 JSON body 才调整。
# KB_MAX_CONTENT_LENGTH=262144

# ─── F3 · 论文上传 / PDF→MD 云 API ──────────────────────────────────────
# pdf2md provider：
#   mineru-cloud（默认）— 走 mineru.net 官方公网 API；需要 KB_MINERU_API_KEY
#   local             — 走 scripts/pdf2md.py（局域网 MinerU），不需要 key
KB_PDF2MD_PROVIDER=mineru-cloud
KB_MINERU_API_KEY=REPLACE_ME_MINERU_KEY
# 可选：自托管或 mineru-staging 时覆盖。仅允许 https；host 必须在 ALLOWED_HOSTS 内
# KB_MINERU_API_URL=https://mineru.net

# 预签名 PUT / zip 下载 URL 的 host 白名单（逗号分隔，含子域后缀匹配）。
# 默认含 mineru.net + openxlab.org.cn(CDN) + 阿里云/腾讯云 OSS。
# 改自托管 MinerU 时把对应 OSS/COS host 加进来。
# KB_MINERU_ALLOWED_HOSTS=mineru.net,openxlab.org.cn,aliyuncs.com

# MinerU 轮询节奏与下载 zip 体积上限
# KB_MINERU_POLL_INTERVAL=5
# KB_MINERU_POLL_TIMEOUT=600
# KB_MINERU_ZIP_MAX_BYTES=209715200

# 关掉上传后台 worker（测试 / 仅展示模式 / 多进程部署）
# KB_DISABLE_UPLOAD_WORKER=1
