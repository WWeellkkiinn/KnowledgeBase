# 公网部署环境变量模板。复制为 .env 后填入真实值；.env 不入库。
#
# 生成 token（至少 32 字节随机；启动脚本会对 <24 字符的值发警告）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠️ cpolar 是公网 TLS 终止方，可见明文请求体；KB_API_TOKEN 等同对外密码，泄露即换。

# 用户登录令牌：在 /login 页面输入这个值才能访问
KB_API_TOKEN=REPLACE_ME_USER_TOKEN

# Flask session / Socket.IO 签名密钥；服务器内部用，不暴露给前端
KB_SECRET_KEY=REPLACE_ME_SECRET_KEY

# 公网部署设 1，启用 ProxyFix（信任 cpolar 隧道注入的 X-Forwarded-For）。
# ⚠️ 仅当上游确实是单跳可信代理时才开启；多跳/链式反代下需调整 ProxyFix x_for 参数。
KB_TRUST_PROXY=1

# 可选：覆盖默认 CORS（多值用逗号分隔）。公网通常无需设置，因为前端与 API 同源。
# KB_CORS_ORIGINS=https://your-domain.cpolar.cn,https://your-domain.cpolar.top

# 启动 APScheduler（订阅、日报等后台任务）；serve.py 默认会设 1，这里显式也行
KB_ENABLE_SCHEDULER=1

# 单请求体上限（字节），默认 262144 = 256KB
# KB_MAX_CONTENT_LENGTH=262144
