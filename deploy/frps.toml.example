# frps（ECS 公网侧）配置
# 生成随机 token（≥32 字节）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 把下方 auth.token 同步到客户端 frpc.toml；不一致会拒连。

bindPort = 7000

# 把所有 type=tcp 反向代理的 remotePort 只绑回环，公网不可见。
# 这样隧道端口只能从本机访问（app 容器走 host.docker.internal），
# 即使 frps 暴露在公网，外网 nmap 也看不到上游服务。
proxyBindAddr = "127.0.0.1"

# 白名单 frpc 可申请映射的端口段，防止已认证客户端任意暴露端口。
# Ollama 默认 11434；按你 frpc.toml 的 remotePort 调整。
allowPorts = [
    { start = 11434, end = 11434 },
    { start = 13813, end = 13813 },
]

[auth]
method = "token"
token = "REPLACE_WITH_RANDOM_TOKEN"

[transport.tls]
# 已知问题（2026-05-16）：fatedier 官方 0.68.1 frps + 0.68.1 frpc 也无法完成 TLS 握手
# （抓包：ClientHello → ServerHello 后 frpc 立即 RST，疑似 custom-first-byte 协商或
# 证书校验细节差异）。临时保持明文，靠强 token + ufw 限源 IP 缓解中间人风险。
# 长期修复：升级到 0.69+ 后两端同步开 force=true / enable=true 再验证。
# force = true

[log]
to = "console"
level = "info"
maxDays = 3

# 不开 webServer（dashboard）；公网少一个攻击面。
# [webServer]
# addr = "127.0.0.1"
# port = 7500
