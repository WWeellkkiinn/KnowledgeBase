# frpc systemd --user unit 模板（Ollama 主机侧）
# ────────────────────────────────────────────────────────────────
# ⚠ 若部署账号无 sudo，loginctl enable-linger 无权限，
#    用户级 systemd 会在用户登出后停。生产请改用 cron：
#       crontab -e
#       @reboot sleep 30 && $HOME/frp/frpc -c $HOME/frp/frpc.toml >> $HOME/frp/frpc.log 2>&1
#
# 本文件保留供有 sudo / 能 enable-linger 的环境使用。
# 安装：
#   mkdir -p ~/.config/systemd/user
#   cp deploy/frpc.service ~/.config/systemd/user/frpc.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now frpc
#   sudo loginctl enable-linger $USER   # ← 需要 sudo
# ────────────────────────────────────────────────────────────────

[Unit]
Description=frpc tunnel to ECS for KnowledgeBase Ollama
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/frp/frpc -c %h/frp/frpc.toml
Restart=always
RestartSec=10
# frpc 自己不写文件，stdout/stderr 走 journalctl --user -u frpc

[Install]
WantedBy=default.target
