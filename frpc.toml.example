# frpc（Ollama 主机侧，**不在 ECS**）
# ────────────────────────────────────────────────────────────────
# 部署在装着 Ollama 的内网机器上（即推理服务所在主机）。
# 作用：把内网 Ollama 的本地端口经 frps 隧道映射到 ECS 的 127.0.0.1:<port>。
# ECS 上 frps 已设 proxyBindAddr=127.0.0.1，所以 remotePort 不会暴露到公网。
#
# 使用步骤：
#   1. 在 Ollama 主机下载 frpc：https://github.com/fatedier/frp/releases
#   2. cp frpc.toml.example frpc.toml；填入下面的 serverAddr / token / 端口
#   3. ./frpc -c frpc.toml 测试一次连通
#   4. 生产用 deploy/frpc.service（systemd）或 cron @reboot 守护
# ────────────────────────────────────────────────────────────────

# ECS 公网 IP 或域名
serverAddr = "REPLACE_WITH_ECS_PUBLIC_IP"
serverPort = 7000

[auth]
method = "token"
# 必须与 ECS frps.toml 里的 auth.token 完全一致
token = "REPLACE_WITH_FRPS_TOKEN"

[transport.tls]
# 与 frps.toml 配套：snowdreamtech/frps:0.68.1 与官方 frpc TLS 不兼容，
# 暂关 TLS。换官方 frps 镜像后改回 enable = true。
enable = false

[[proxies]]
name = "ollama"
type = "tcp"
localIP = "127.0.0.1"
# Ollama 在本机的实际监听端口。原生安装通常是 11434；
# 若走 rootless docker / 端口转发请填实际监听端口。
localPort = 11434
# 映射到 ECS 本机 127.0.0.1:<remotePort>，应用通过 host.docker.internal:<remotePort> 访问
remotePort = 11434
