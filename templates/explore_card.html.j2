<div style="border:1px solid #e2e8f0;border-radius:8px;padding:16px;margin-bottom:16px;background:#fff;font-size:13px;line-height:1.6;color:#334155">
  {% if card_index is not none %}<p style="margin:0 0 8px;font-size:12px;color:#475569;font-weight:700"><b>No.{{ card_index }}</b></p>{% endif %}
  <p style="margin:0;font-size:15px;color:#1e293b">
    {% if url %}<a href="{{ url }}" style="color:#1e293b;text-decoration:none"><strong>{{ title }}</strong></a>{% else %}<strong>{{ title }}</strong>{% endif %}
    {% if embedding_score is not none %}<span style="background:#f0fdf4;color:#16a34a;border-radius:9999px;padding:1px 8px;font-size:11px;margin-left:6px;font-weight:normal">相关度 {{ "%.2f"|format(embedding_score) }}</span>{% endif %}
  </p>

  {% if title_zh %}<p style="margin:4px 0 0;font-size:15px;color:#1e293b"><strong>{{ title_zh }}</strong></p>{% endif %}

  <p style="margin:6px 0 0;font-size:12px;color:#64748b">
    {{ display_date }}{% if authors %} · {{ authors }}{% endif %}{% if venue_name %} (<em style="font-style:italic;color:#475569">{{ venue_name }}</em>{% if rank_badges %} · {% for b in rank_badges %}{% if b.label == 'SCI' %}<span style="background:#dbeafe;color:#1d4ed8;border-radius:3px;padding:0 5px;font-size:11px;font-style:normal">{{ b.value }}</span>{% elif b.label == 'SSCI' %}<span style="background:#e0e7ff;color:#4338ca;border-radius:3px;padding:0 5px;font-size:11px;font-style:normal">{{ b.value }}</span>{% elif b.label == 'IF' %}<span style="background:#dcfce7;color:#15803d;border-radius:3px;padding:0 5px;font-size:11px;font-style:normal">IF {{ b.value }}</span>{% elif b.label == '中科院' %}<span style="background:#ffedd5;color:#c2410c;border-radius:3px;padding:0 5px;font-size:11px;font-style:normal">{{ b.value }}</span>{% elif b.label == 'Top' %}<span style="background:#ffe4e6;color:#be123c;border-radius:3px;padding:0 5px;font-size:11px;font-style:normal">Top</span>{% elif b.label == 'CCF' %}<span style="background:#f3e8ff;color:#7e22ce;border-radius:3px;padding:0 5px;font-size:11px;font-style:normal">CCF {{ b.value }}</span>{% elif b.label == 'CSSCI' %}<span style="background:#ccfbf1;color:#0f766e;border-radius:3px;padding:0 5px;font-size:11px;font-style:normal">CSSCI</span>{% endif %}{% if not loop.last %} {% endif %}{% endfor %}{% endif %}){% endif %}{% if cited_by_count %} · cited {{ cited_by_count }}{% endif %}
  </p>

  {% if tags %}
  <p style="margin:8px 0 0">
    {% for tag in tags %}<span style="background:#dbeafe;color:#1d4ed8;border-radius:9999px;padding:1px 9px;font-size:12px;display:inline-block;margin:2px 4px 0 0">{{ tag }}</span>{% endfor %}
  </p>
  {% endif %}

  {% if llm_reason %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>为什么推给你</strong></p>
  <p style="margin:0">{{ llm_reason }}</p>
  {% endif %}

  {% if research_question %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>一句话</strong></p>
  <p style="margin:0">{{ research_question }}</p>
  {% endif %}

  {% if key_findings %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>有什么用</strong></p>
  <ul style="margin:0;padding-left:20px;list-style-type:disc">
    {% for f in key_findings %}<li style="list-style-type:disc">{{ f }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if methodology %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>怎么做</strong></p>
  <p style="margin:0">{{ methodology }}</p>
  {% endif %}
</div>
