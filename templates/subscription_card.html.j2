<div style="border:1px solid #e2e8f0;border-radius:8px;padding:16px;margin-bottom:16px;background:#fff;font-size:13px;line-height:1.6;color:#334155">
  {% if card_index is not none %}<p style="margin:0 0 8px;font-size:12px;color:#475569;font-weight:700"><b>No.{{ card_index }}</b></p>{% endif %}
  <p style="margin:0;font-size:15px;color:#1e293b">
    {% if url %}<a href="{{ url }}" style="color:#1e293b;text-decoration:none"><strong>{{ title }}</strong></a>{% else %}<strong>{{ title }}</strong>{% endif %}
    {% if llm_score is not none %}<span style="background:#f0fdf4;color:#16a34a;border-radius:9999px;padding:1px 8px;font-size:11px;margin-left:6px;font-weight:normal">相关度 {{ "%.2f"|format(llm_score) }}</span>{% endif %}
  </p>

  {% if title_zh %}<p style="margin:4px 0 0;font-size:15px;color:#1e293b"><strong>{{ title_zh }}</strong></p>{% endif %}

  <p style="margin:6px 0 0;font-size:12px;color:#64748b">
    {{ display_date }}{% if authors %} · {{ authors }}{% endif %}{% if cited_by_count %} · cited {{ cited_by_count }}{% endif %}
  </p>

  {% if tags %}
  <p style="margin:8px 0 0">
    {% for tag in tags %}<span style="background:#dbeafe;color:#1d4ed8;border-radius:9999px;padding:1px 9px;font-size:12px;display:inline-block;margin:2px 4px 0 0">{{ tag }}</span>{% endfor %}
  </p>
  {% endif %}

  {% if research_question %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>一句话</strong></p>
  <p style="margin:0">{{ research_question }}</p>
  {% endif %}

  {% if key_findings %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>有什么用</strong></p>
  <ul style="margin:0;padding-left:20px">
    {% for f in key_findings %}<li>{{ f }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if methodology %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>怎么做</strong></p>
  <p style="margin:0">{{ methodology }}</p>
  {% endif %}

  {% if llm_reason %}
  <p style="margin:12px 0 2px;color:#0f172a"><strong>为什么推给你</strong></p>
  <p style="margin:0">{{ llm_reason }}</p>
  {% endif %}

  <div style="margin-top:14px;display:flex;align-items:center;justify-content:space-between">
    <p style="margin:0;font-size:11px;color:#94a3b8">订阅：{{ subscription_label }}</p>
    {% if paper_id %}
    <span style="font-size:13px;color:#16a34a;background:#f0fdf4;padding:5px 14px;border-radius:9999px;border:1px solid #bbf7d0;font-weight:500">✓ 已入库</span>
    {% else %}
    <button data-import-id="{{ result_id }}" style="font-size:13px;color:#2563eb;background:#eff6ff;padding:5px 14px;border-radius:9999px;border:1px solid #bfdbfe;cursor:pointer;font-weight:500">+ 入库</button>
    {% endif %}
  </div>
</div>
